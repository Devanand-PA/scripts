#!/usr/bin/env bash

SOURCE_DIR="$HOME/sourced"
LOG_DIR="/tmp/git-pull-logs"

mkdir -p "$LOG_DIR"

for dir in "$SOURCE_DIR"/*/; do
    [[ -d "$dir/.git" ]] || continue

    repo=$(basename "$dir")

    (
        echo ">>> Pulling $repo"
        cd "$dir" || exit 1
        git pull
    ) > "$LOG_DIR/$repo.log" 2>&1 &

    echo "Started: $repo"
done

wait

echo
echo "All repositories finished."
echo "Logs are in: $LOG_DIR"
