class ImageSelector(QMainWindow):

    def __init__(self, image_paths, display_labels=None,
                 pre_select_labels=None, pass_idx=0, idx_write_path="",
                 custom_title="", gallery_rows=None, gallery_cols=None,
                 gallery_tile_size=None, gallery_aspect=None):
        super().__init__()

        self._gallery_rows_opt = (gallery_rows
                                  if gallery_rows and gallery_rows > 0 else None)
        self._gallery_cols_opt = (gallery_cols
                                  if gallery_cols and gallery_cols > 0 else None)
        self._gallery_tile_opt = (gallery_tile_size
                                  if gallery_tile_size and gallery_tile_size > 0
                                  else None)
        self._gallery_aspect_opt = (gallery_aspect
                                    if gallery_aspect and gallery_aspect > 0
                                    else None)
        self._gallery_aspect_cache = None

        self.idx_write_path = idx_write_path
        self.custom_title = custom_title

        if display_labels is None:
            self.all_items = [(os.path.basename(p), p) for p in image_paths]
        else:
            if len(display_labels) != len(image_paths):
                raise ValueError(
                    "display_labels and image_paths must have same length")
            self.all_items = list(zip(display_labels, image_paths))

        self.filtered_items = self.all_items.copy()
        self.path_to_abs_index = {
            path: idx for idx, (_, path) in enumerate(self.all_items)
        }

        self._closing = False
        self._last_index = -1
        self._scan_thread = None
        self._scan_done = threading.Event()
        self._scan_done.set()
        self.selected_path = None
        self.selected_label = None
        self.selected_paths = set()
        self.selected_paths_list = []
        self.selected_labels_list = []
        self._base_status_text = ""
        self._suppress_list_signal = False

        # View state
        self.view_mode = "list"

        # Gallery metrics
        self._tile_w = 240
        self._tile_h = 240
        self._tile_caption_h = 34
        self._tile_pad = 10
        self._tile_thumb_max = (self._tile_w - 5, self._tile_h - 5)
        self._gallery_tiles = {}
        self._gallery_cols = 1
        self._gallery_grid_dirty = True
        self._gallery_built = False
        self._pending_gallery_scroll = None
        self._gallery_gen = 0

        # ── In-memory caches (GUI thread only) ──
        # (path, bucket) -> (QPixmap, (orig_w, orig_h))
        self._pixmap_cache = OrderedDict()
        # path -> (w, h) header cache
        self._orig_size = OrderedDict()

        # ── Decode pipeline ──
        # (path, bucket) -> [callback, ...]  (waiters on the GUI thread)
        self._decode_waiters = {}
        self._decode_bridge = _DecodeBridge()
        self._decode_bridge.done.connect(self._on_decode_done,
                                         Qt.QueuedConnection)
        self._decode_pool = _DecodePool(DECODE_WORKERS,
                                        self._decode_bridge.done.emit)

        # ── Scan pipeline ──
        self._scan_bridge = _ScanBridge()
        self._scan_bridge.file_found.connect(self._append_to_list,
                                             Qt.QueuedConnection)

        if pre_select_labels:
            self._apply_pre_select(pre_select_labels)

        self._setup_window()
        self._build_ui()
        self._populate_list()
        if self.filtered_items:
            self._select_and_show(pass_idx)
        self.input.setFocus()

    # ── Thumbnail request pipeline ───────────────────────────────────────────

    def _cache_pixmap(self, key, pixmap, orig_size):
        self._pixmap_cache[key] = (pixmap, orig_size)
        self._pixmap_cache.move_to_end(key)
        while len(self._pixmap_cache) > QPIXMAP_CACHE_MAX:
            self._pixmap_cache.popitem(last=False)

    def _cache_orig_size(self, path, size):
        if not size or size == (0, 0):
            return
        self._orig_size[path] = size
        self._orig_size.move_to_end(path)
        while len(self._orig_size) > ORIG_SIZE_CACHE_MAX:
            self._orig_size.popitem(last=False)

    def _request_thumbnail(self, path, max_w, max_h, callback, priority=1):
        """Request a thumbnail decode at the bucket covering (max_w, max_h).

        `callback(pixmap_or_None, orig_size)` runs on the GUI thread.  It
        may be invoked synchronously (cache hit) or later (decode done).
        `priority`: 0 = current item, 1 = neighbour prefetch, 2 = gallery.
        """
        if self._closing:
            return
        bucket = _bucket_for(max_w, max_h)
        key = (path, bucket)

        # 1) Ready QPixmap
        entry = self._pixmap_cache.get(key)
        if entry is not None:
            self._pixmap_cache.move_to_end(key)
            callback(entry[0], entry[1])
            return

        # 2) Already decoding — piggyback on the pending result.
        waiters = self._decode_waiters.get(key)
        if waiters is not None:
            waiters.append(callback)
            return

        # 3) Fresh decode.
        self._decode_waiters[key] = [callback]
        self._decode_pool.submit(priority, path, bucket)

    def _on_decode_done(self, path, bucket, pil_img, orig_size, err):
        """GUI-thread handler for a completed decode."""
        if self._closing:
            return
        key = (path, bucket)
        waiters = self._decode_waiters.pop(key, [])

        if pil_img is None:
            for cb in waiters:
                try:
                    cb(None, orig_size)
                except Exception:
                    pass
            return

        self._cache_orig_size(path, orig_size)

        pixmap = _pil_to_qpixmap(pil_img)
        if pixmap is not None:
            self._cache_pixmap(key, pixmap, orig_size)

        for cb in waiters:
            try:
                cb(pixmap, orig_size)
            except Exception:
                pass

    # ── Pre-select ───────────────────────────────────────────────────────────

    def _apply_pre_select(self, pre_select_labels):
        target_labels = set(pre_select_labels)
        matched = set()
        for label, path in self.all_items:
            if label in target_labels and label not in matched:
                self.selected_paths.add(path)
                matched.add(label)

