# ─── Decode helpers (run on worker threads) ──────────────────────────────────

def _read_orig_size(path):
    """Cheap header-only read. Does not decode pixel data."""
    if HAS_VIPS:
        try:
            v = pyvips.Image.new_from_file(path)
            return (int(v.width), int(v.height))
        except Exception:
            pass
    try:
        with Image.open(path) as img:
            return img.size
    except Exception:
        return (0, 0)


def _disk_cache_path(path, mtime_ns, bucket):
    key = hashlib.sha1(
        f"{path}|{mtime_ns}|{bucket}".encode("utf-8")
    ).hexdigest()
    return CACHE_DIR / key[:2] / (key + ".webp")


def _decode_image(path, bucket):
    """Decode/thumbnail `path` to fit inside (bucket, bucket).

    Returns (PIL.Image or None, (orig_w, orig_h)).
    """
    orig_size = (0, 0)
    cache_file = None

    if DISK_CACHE_ENABLED:
        try:
            st = os.stat(path)
            cache_file = _disk_cache_path(path, st.st_mtime_ns, bucket)
        except OSError:
            cache_file = None
        if cache_file is not None and cache_file.exists():
            try:
                with Image.open(cache_file) as img:
                    img.load()
                    pil = img.copy()
                orig_size = _read_orig_size(path)
                return pil, orig_size
            except Exception:
                try:
                    cache_file.unlink()
                except OSError:
                    pass

    pil_img = None

    # ── pyvips fast path (shrink-on-load) ──
    if HAS_VIPS and HAS_NUMPY:
        try:
            v = pyvips.Image.new_from_file(path)
            orig_size = (int(v.width), int(v.height))
            thumb = pyvips.Image.thumbnail(path, bucket, height=bucket,
                                           size="down")
            arr = thumb.numpy()
            if not arr.flags["C_CONTIGUOUS"]:
                arr = _np.ascontiguousarray(arr)
            if arr.ndim == 2:
                pil_img = Image.fromarray(arr, "L")
            else:
                b = arr.shape[2]
                if b == 3:
                    pil_img = Image.fromarray(arr, "RGB")
                elif b == 4:
                    pil_img = Image.fromarray(arr, "RGBA")
                elif b == 2:
                    pil_img = Image.fromarray(arr, "LA")
                elif b == 1:
                    pil_img = Image.fromarray(arr[:, :, 0], "L")
                else:
                    pil_img = Image.fromarray(arr[:, :, :4], "RGBA")
        except Exception:
            pil_img = None

    # ── PIL fallback ──
    if pil_img is None:
        try:
            with Image.open(path) as img:
                orig_size = img.size
                if img.format == "JPEG":
                    img.draft("RGB", (bucket, bucket))
                if img.width > bucket * 4 or img.height > bucket * 4:
                    factor = max(1, min(img.width // (bucket * 2),
                                        img.height // (bucket * 2)))
                    if factor > 1:
                        img = img.reduce(factor)
                img.thumbnail((bucket, bucket),
                              Image.Resampling.BILINEAR,
                              reducing_gap=2.0)
                if img.mode not in ("RGB", "RGBA", "L", "LA"):
                    img = img.convert("RGB")
                img.load()
                pil_img = img.copy()
        except Exception:
            pil_img = None

    # ── Populate the on-disk cache (only when explicitly enabled) ──
    if pil_img is not None and cache_file is not None:
        try:
            cache_file.parent.mkdir(parents=True, exist_ok=True)
            tmp = cache_file.with_name(cache_file.name + ".tmp")
            pil_img.save(tmp, "WEBP", quality=CACHE_WEBP_QUALITY, method=0)
            os.replace(tmp, cache_file)
        except Exception:
            try:
                if tmp is not None:
                    tmp.unlink()
            except Exception:
                pass

    return pil_img, orig_size


def _pil_to_qpixmap(pil_img):
    """Convert a PIL image to a QPixmap.

    Must be called on the GUI thread.  Does exactly one copy into a
    QPixmap (the QImage wraps the temporary bytes and is immediately
    blitted into the QPixmap, then discarded).
    """
    if pil_img is None:
        return None
    try:
        mode = pil_img.mode
        w, h = pil_img.size
        if mode == "RGBA":
            data = pil_img.tobytes("raw", "RGBA")
            fmt = QImage.Format_RGBA8888
            bpl = w * 4
        elif mode == "RGB":
            data = pil_img.tobytes("raw", "RGB")
            fmt = QImage.Format_RGB888
            bpl = w * 3
        elif mode == "L":
            data = pil_img.tobytes("raw", "L")
            fmt = QImage.Format_Grayscale8
            bpl = w
        else:
            pil_img = pil_img.convert("RGBA")
            w, h = pil_img.size
            data = pil_img.tobytes("raw", "RGBA")
            fmt = QImage.Format_RGBA8888
            bpl = w * 4
        qimg = QImage(data, w, h, bpl, fmt)
        return QPixmap.fromImage(qimg)
    except Exception:
        return None


def _scaled_pixmap(pixmap, max_w, max_h):
    """Downscale a pixmap to fit (max_w, max_h). Cheap on the GUI thread."""
    if pixmap is None or pixmap.isNull():
        return None
    max_w = max(1, int(max_w))
    max_h = max(1, int(max_h))
    if pixmap.width() <= max_w and pixmap.height() <= max_h:
        return pixmap
    return pixmap.scaled(max_w, max_h, Qt.KeepAspectRatio,
                         Qt.SmoothTransformation)


# ─── Priority decode pool ────────────────────────────────────────────────────

class _DecodePool:
    """Fixed-size worker pool with a priority queue.

    The pool only schedules work; it holds no per-job state.  The caller
    is responsible for deduplicating (path, bucket) pairs before calling
    `submit`.
    """

    def __init__(self, workers, on_result):
        self._on_result = on_result
        self._cv = threading.Condition()
        self._heap = []
        self._seq = 0
        self._stop = False
        self._threads = []
        for _ in range(max(1, workers)):
            t = threading.Thread(target=self._run, daemon=True,
                                 name="selimgqt-decode")
            t.start()
            self._threads.append(t)

    def submit(self, priority, path, bucket):
        with self._cv:
            if self._stop:
                return
            self._seq += 1
            heapq.heappush(self._heap, (int(priority), self._seq, path, bucket))
            self._cv.notify()

    def stop(self):
        with self._cv:
            self._stop = True
            self._cv.notify_all()

    def _run(self):
        while True:
            with self._cv:
                while not self._heap and not self._stop:
                    self._cv.wait()
                if self._stop and not self._heap:
                    return
                if not self._heap:
                    continue
                _prio, _seq, path, bucket = heapq.heappop(self._heap)
            try:
                pil_img, orig_size = _decode_image(path, bucket)
                err = None
            except Exception as e:
                pil_img, orig_size, err = None, (0, 0), e
            try:
                self._on_result(path, bucket, pil_img, orig_size, err)
            except Exception:
                pass


# ─── Cross-thread bridge (worker -> GUI thread) ──────────────────────────────

class _DecodeBridge(QObject):
    # path, bucket, pil_img (or None), orig_size, err (or None)
    done = Signal(str, int, object, object, object)


class _ScanBridge(QObject):
    file_found = Signal(str)


# ─── Custom list delegate ────────────────────────────────────────────────────

class _ListItemDelegate(QStyledItemDelegate):
    """Draws list rows with colours matching the Tk original."""

    def __init__(self, app):
        super().__init__()
        self.app = app

    def paint(self, painter, option, index):
        painter.save()
        rect = option.rect
        path = index.data(Qt.UserRole)
        is_current = bool(option.state & QStyle.State_Selected)
        is_preselected = path in self.app.selected_paths

        if is_current:
            bg = QColor(THEME["accent"])
            fg = QColor(THEME["accent_fg"])
        elif is_preselected:
            bg = QColor(THEME["selected_bg"])
            fg = QColor(THEME["selected_fg"])
        else:
            bg = QColor(THEME["bg_secondary"])
            fg = QColor(THEME["fg_text"])

        painter.fillRect(rect, bg)
        painter.setPen(fg)
        text = index.data(Qt.DisplayRole) or ""
        painter.drawText(rect.adjusted(8, 0, -8, 0),
                         Qt.AlignVCenter | Qt.AlignLeft, text)
        painter.restore()

    def sizeHint(self, option, index):
        s = super().sizeHint(option, index)
        s.setHeight(max(s.height(), 22))
        return s


# ─── Search entry ────────────────────────────────────────────────────────────

class SearchEntry(QLineEdit):
    """Line edit that forwards navigation/confirm keys to the app."""

    def __init__(self, app, parent=None):
        super().__init__(parent)
        self.app = app

    def keyPressEvent(self, event):
        app = self.app
        key = event.key()
        mods = event.modifiers()
        ctrl = bool(mods & Qt.ControlModifier)

        if key in (Qt.Key_Return, Qt.Key_Enter):
            if ctrl:
                app._on_ctrl_return()
            else:
                app._on_confirm()
            event.accept()
            return
        if key == Qt.Key_Escape:
            app._on_cancel()
            event.accept()
            return
        if key == Qt.Key_C and ctrl:
            app._on_ctl_c()
            event.accept()
            return
        if key == Qt.Key_Tab:
            app._toggle_view()
            event.accept()
            return
        if key == Qt.Key_G and ctrl:
            app._toggle_view()
            event.accept()
            return
        if key == Qt.Key_Up:
            app._nav_up()
            event.accept()
            return
        if key == Qt.Key_Down:
            app._nav_down()
            event.accept()
            return
        if key == Qt.Key_Left and app.view_mode == "gallery":
            app._nav_left()
            event.accept()
            return
        if key == Qt.Key_Right and app.view_mode == "gallery":
            app._nav_right()
            event.accept()
            return
        if key == Qt.Key_PageUp and app.view_mode == "gallery":
            app._gallery_page(-1)
            event.accept()
            return
        if key == Qt.Key_PageDown and app.view_mode == "gallery":
            app._gallery_page(1)
            event.accept()
            return
        super().keyPressEvent(event)


# ─── Gallery tile ────────────────────────────────────────────────────────────

class GalleryTile(QFrame):
    """A single thumbnail + caption tile in the gallery view."""

    def __init__(self, parent, app, index, label, path):
        super().__init__(parent)
        self.setObjectName("galleryTile")
        self.setAttribute(Qt.WA_StyledBackground, True)
        self.setFocusPolicy(Qt.NoFocus)

        self.app = app
        self.index = index
        self.label = label
        self.path = path
        self._pixmap = None
        self._selected = False
        self._current = False

        layout = QVBoxLayout(self)
        layout.setContentsMargins(2, 2, 2, 2)
        layout.setSpacing(0)

        self.thumb = QLabel(self)
        self.thumb.setAlignment(Qt.AlignCenter)
        self.thumb.setText("…")
        self.thumb.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Ignored)
        self.thumb.setMinimumSize(1, 1)
        self.thumb.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.thumb.setStyleSheet(
            f"background-color: {THEME['bg_secondary']}; color: {THEME['fg_text']};"
        )
        layout.addWidget(self.thumb, 1)

        self.caption = QLabel(label, self)
        self.caption.setAlignment(Qt.AlignCenter)
        self.caption.setWordWrap(True)
        self.caption.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.caption.setStyleSheet(
            f"background-color: {THEME['bg_secondary']}; "
            f"color: {THEME['fg_text']}; font-size: 9px;"
        )
        try:
            self.caption.setFixedHeight(max(1, int(app._tile_caption_h)))
        except Exception:
            self.caption.setFixedHeight(22)
        layout.addWidget(self.caption, 0)

        self._refresh_border()

    # ── mouse events ──
    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.app._select_and_show(self.index, from_gallery=True)
            self.app.input.setFocus()
            event.accept()
            return
        super().mousePressEvent(event)

    def mouseDoubleClickEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.app._select_and_show(self.index, from_gallery=True)
            self.app._on_confirm()
            event.accept()
            return
        super().mouseDoubleClickEvent(event)

    def enterEvent(self, event):
        if not self._selected and not self._current:
            self.setStyleSheet(
                f"QFrame#galleryTile {{ background-color: {THEME['bg_secondary']}; "
                f"border: 2px solid {THEME['hover_border']}; }}"
            )
        super().enterEvent(event)

    def leaveEvent(self, event):
        self._refresh_border()
        super().leaveEvent(event)

    # ── public API ──
    def set_photo(self, pixmap):
        """Install a pixmap already scaled to the tile's thumbnail area."""
        self._pixmap = pixmap
        if pixmap is not None and not pixmap.isNull():
            self.thumb.setPixmap(pixmap)
            self.thumb.setText("")
        else:
            self.thumb.setPixmap(QPixmap())
            self.thumb.setText("✕")

    def update_item(self, index, label, path):
        """Recycle this tile. Returns True if the path changed."""
        self.index = index
        if self.path == path:
            if self.label != label:
                self.label = label
                self.caption.setText(label)
            return False
        self.label = label
        self.path = path
        self.caption.setText(label)
        self._pixmap = None
        self.thumb.setPixmap(QPixmap())
        self.thumb.setText("…")
        return True

    def set_selected(self, selected):
        if self._selected == selected:
            return
        self._selected = selected
        self._refresh_border()

    def set_current(self, current):
        if self._current == current:
            return
        self._current = current
        self._refresh_border()

    def _refresh_border(self):
        if self._selected:
            color = THEME["selected_bg"]
            width = 3
        elif self._current:
            color = THEME["accent"]
            width = 2
        else:
            color = THEME["bg_secondary"]
            width = 2
        self.setStyleSheet(
            f"QFrame#galleryTile {{ background-color: {THEME['bg_secondary']}; "
            f"border: {width}px solid {color}; }}"
        )


