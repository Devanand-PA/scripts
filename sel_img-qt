# ── Thumbnail size buckets ───────────────────────────────────────────────────
# Every decode request is snapped up to one of these, so the list view, the
# gallery view, and small window resizes all hit the same cache entry.
SIZE_BUCKETS = (128, 192, 256, 384, 512, 768, 1024, 1536, 2048)


def _bucket_for(w, h):
    m = max(int(w), int(h))
    for b in SIZE_BUCKETS:
        if m <= b:
            return b
    return SIZE_BUCKETS[-1]


# ── In-memory caches ─────────────────────────────────────────────────────────
QPIXMAP_CACHE_MAX = 384       # ready-to-paint thumbnails
ORIG_SIZE_CACHE_MAX = 8192    # (path -> (w, h)) header cache

# ── Decode pool ──────────────────────────────────────────────────────────────
DECODE_WORKERS = max(2, min(8, os.cpu_count() or 4))

# ── Prefetch ─────────────────────────────────────────────────────────────────
PRELOAD_AHEAD = 2

# ── Optional on-disk cache ───────────────────────────────────────────────────
